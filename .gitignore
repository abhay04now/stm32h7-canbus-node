*.bin
*.hex

# --- IDE clutter / machine-specific files ---
.metadata/
# Launch config contains absolute paths (/home/<user>/...)
*.launch
# Per-machine toolchain env-hash, regenerated by the IDE
.settings/language.settings.xml
# Debugger SFR-view UI state
.settings/com.st.stm32cube.ide.mcu.sfrview.prefs

# Kept on purpose: .project, .cproject, .mxproject, *.ioc, *.ld,
